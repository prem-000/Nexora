flowchart TD
    A[App Launch] --> B{Identity exists?}
    
    B -->|No| C[Setup or Login]
    B -->|Yes| D[Load User Profile]
    C --> D
    
    D --> E[Initialize Database]
    E --> F[Start Mesh Engine]

    F --> G[Fork Active Services]

    subgraph Discovery_Loop [Discovery and Heartbeat Loop]
        G --> H[Auto Discovery and Advertise]
        H --> I{Peer Detected?}
        I -->|Yes| J[P2P Connection Handshake]
        I -->|No| K[10s Heartbeat Beacon]
        J --> L[Exchange Route Topology]
        L --> K
        K --> M[Purge Expired Routes TTL 35s]
        M --> H
    end

    subgraph Message_Handling [Message Alert and File Handling]
        G --> N{Incoming Traffic}
        N -->|Chat| O[AES-256 Direct Chat]
        N -->|SOS| P[Broadcast SOS Alert]
        N -->|File| Q[TCP Port 8888 Transfer]
        O --> R[Persist in Room Database]
        P --> R
        Q --> R
    end

    subgraph Offline_Recovery [Background and Offline Recovery]
        R --> S{Network Partition?}
        S -->|Yes| T[DTN Store and Forward Custody]
        T --> U{Neighbor Reconnected?}
        U -->|Yes| V[Replicate Stored Alerts]
        V --> H
        U -->|No| T
        S -->|No| W{App Terminated?}
        W -->|No| G
        W -->|Yes| X[Stop Radios and Mark Offline]
        X --> Y[App Teardown Complete]
    end