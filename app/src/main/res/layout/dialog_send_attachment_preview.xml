<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_attachment"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/textPreviewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Send Attachment"
        android:textColor="@color/nexora_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/nexora_surface"
        app:cardCornerRadius="12dp"
        app:strokeColor="@color/nexora_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imagePreviewThumbnail"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iconFilePreview"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_document"
                app:tint="@color/nexora_cyan" />

            <TextView
                android:id="@+id/textPreviewFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="middle"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/nexora_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPreviewFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/nexora_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🔒 End-to-End Encrypted via Mesh"
                android:textColor="@color/nexora_cyan"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelPreview"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textColor="@color/nexora_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmSend"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/nexora_cyan"
            android:text="Send"
            android:textColor="#FFFFFF"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
