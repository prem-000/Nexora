<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/nexora_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/nexora_border"
    app:strokeWidth="1dp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/nexora_text_primary"
            android:gravity="center"
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create SOS / Alert"/>
        <!-- Alert Mode Selection -->
        <RadioGroup
            android:id="@+id/radioGroupAlertType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/radioStandardSos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Standard SOS"
                android:textColor="@color/nexora_text_primary"
                android:textSize="13sp" />
            <RadioButton
                android:id="@+id/radioCriticalEmergency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="🚨 Critical Alert"
                android:textColor="@color/nexora_red"
                android:textStyle="bold"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- Critical Emergency Extra Options -->
        <LinearLayout
            android:id="@+id/layoutCriticalOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency Category:"
                android:textColor="@color/nexora_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerCriticalCategory"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Notification Radius:"
                android:textColor="@color/nexora_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerCriticalRadius"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <EditText
            android:textSize="14sp"
            android:textColor="@color/nexora_text_primary"
            android:textColorHint="@color/nexora_text_muted"
            android:gravity="start|top"
            android:id="@+id/editAlertDesc"
            android:background="@drawable/bg_badge_pill"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="12dp"
            android:hint="Describe the emergency or operational alert..."
            android:inputType="textMultiLine"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <com.google.android.material.button.MaterialButton
                android:textSize="13sp"
                android:textColor="@color/nexora_red"
                android:id="@+id/btnAttachAlertFile"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Attach File"
                app:icon="@drawable/ic_document"
                app:iconTint="@color/nexora_red"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:strokeColor="@color/nexora_red"
                style="@style/Widget.Material3.Button.OutlinedButton"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/nexora_text_secondary"
                android:ellipsize="end"
                android:id="@+id/textAttachedFileName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="No file attached"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
        </LinearLayout>

        <!-- Geo-Tag Switch -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkAttachLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="📍 Attach offline GPS coordinates"
            android:textColor="@color/nexora_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textAlertLocationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:textColor="@color/nexora_text_secondary"
            android:textSize="11sp"
            android:text="GPS ready • Automatically tagged" />

        <com.google.android.material.button.MaterialButton
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/btnSendAlert"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Broadcast SOS Alert"
            android:textAllCaps="false"
            app:backgroundTint="@color/nexora_red"
            app:cornerRadius="12dp"
            app:elevation="0dp"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="14sp"
            android:textColor="@color/nexora_text_secondary"
            android:id="@+id/btnCancelCreateAlert"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="Cancel"
            android:textAllCaps="false"
            style="@style/Widget.Material3.Button.TextButton"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
