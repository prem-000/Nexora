<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="4dp"
    android:layout_marginTop="5dp"
    android:layout_marginRight="4dp"
    android:layout_marginBottom="5dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/nexora_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/nexora_border"
    app:strokeWidth="1dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/nexora_red"
            android:gravity="center"
            android:id="@+id/peerAvatar"
            android:background="@drawable/bg_avatar_circle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="P"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/nexora_text_primary"
            android:ellipsize="end"
            android:id="@+id/peerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Peer Name"
            android:maxLines="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/statusText"
            app:layout_constraintStart_toEndOf="@+id/peerAvatar"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/nexora_text_secondary"
            android:id="@+id/lastSeenText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Tap to open conversation"
            android:layout_marginStart="14dp"
            app:layout_constraintEnd_toStartOf="@+id/statusText"
            app:layout_constraintStart_toEndOf="@+id/peerAvatar"
            app:layout_constraintTop_toBottomOf="@+id/peerName"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/nexora_live"
            android:id="@+id/statusText"
            android:background="@drawable/bg_badge_pill"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● ONLINE"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
