<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="12dp"
    android:paddingTop="4dp"
    android:paddingRight="12dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/nexora_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/nexora_border"
        app:strokeWidth="1dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nexora_text_secondary"
                android:id="@+id/badgeDocHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOCUMENT"
                android:letterSpacing="0.08"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iconFile"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:src="@drawable/ic_document"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/badgeDocHeader"
                app:tint="@color/nexora_red"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/nexora_text_primary"
                android:ellipsize="middle"
                android:id="@+id/textFileName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="DOCUMENT.pdf"
                android:maxLines="2"
                android:layout_marginStart="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iconFile"
                app:layout_constraintTop_toTopOf="@+id/iconFile"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/nexora_text_secondary"
                android:id="@+id/textFileMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Received Attachment · Tap to open"
                android:layout_marginStart="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iconFile"
                app:layout_constraintTop_toBottomOf="@+id/textFileName"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/nexora_text_secondary"
                android:id="@+id/textSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Peer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iconFile"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/nexora_text_secondary"
                android:id="@+id/textTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:22 AM"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@+id/textSender"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
